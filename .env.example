# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP_CLOUD_API_TOKEN: Permanent or temporary Access Token from Meta Developer Portal
WHATSAPP_CLOUD_API_TOKEN=""

# WHATSAPP_PHONE_NUMBER_ID: Phone Number ID associated with your Meta WhatsApp Business Account
WHATSAPP_PHONE_NUMBER_ID=""

# WHATSAPP_RECIPIENT_NUMBER: Shop Owner's WhatsApp Phone Number (E.164 format without +, e.g. 923251229333)
WHATSAPP_RECIPIENT_NUMBER="923251229333"

# WHATSAPP_TEMPLATE_NAME: Optional template name if using approved Meta message templates (e.g. new_order_alert)
WHATSAPP_TEMPLATE_NAME=""

# SMTP Email Notifications Configuration (Optional / Recommended)
# Configure SMTP credentials to automatically send order confirmation emails to customers and alert emails to shop owner.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="fakharyasin9@gmail.com"
SMTP_PASS=""
SMTP_FROM_EMAIL="fakharyasin9@gmail.com"
SMTP_FROM_NAME="Pizza Pro Shergarh"

# SHOP_OWNER_EMAIL: Shop Owner / Manager email address to receive real-time new order alerts
SHOP_OWNER_EMAIL="fakharyasin9@gmail.com"

